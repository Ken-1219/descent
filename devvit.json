{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "descent-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Start Floor 1",
        "description": "Post the first Descent floor (once)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Seed bot ghosts",
        "description": "Bot runs on today's floor (flagged, purgeable)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/seed-bots"
      },
      {
        "label": "Purge bot ghosts",
        "description": "Remove all bot runs from today's floor",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/purge-bots"
      },
      {
        "label": "Reset my run on the live floor",
        "description": "Dev tool: clear your run, ghost and carving to play again",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-run"
      },
      {
        "label": "Roll over now",
        "description": "Dev tool: open tomorrow's floor from today's crowd",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/roll-now"
      },
      {
        "label": "Set the Warden's links",
        "description": "Dev tool: lower the live Warden's links to test its kill",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/set-links"
      },
      {
        "label": "Post Floor 0",
        "description": "A practice post that plays the tutorial",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-floor0"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "descent_game_dev"
  },
  "scheduler": {
    "tasks": {
      "rollover": {
        "endpoint": "/internal/scheduler/rollover",
        "cron": "0 15 * * *"
      },
      "flair": {
        "endpoint": "/internal/scheduler/flair"
      },
      "memorial": {
        "endpoint": "/internal/scheduler/memorial"
      }
    }
  },
  "forms": {
    "seedBots": "/internal/form/seed-bots",
    "setLinks": "/internal/form/set-links"
  },
  "settings": {
    "subreddit": {
      "devTools": {
        "type": "boolean",
        "label": "Dev tools (reset my run, roll over now, set the Warden's links)",
        "helpText": "Switch off before submission.",
        "defaultValue": false
      }
    }
  }
}
