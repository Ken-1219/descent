{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "descent-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "journeys": true
  },
  "menu": {
    "items": [
      {
        "label": "Start Floor 1",
        "description": "Post the first Descent floor (once)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Seed bot ghosts",
        "description": "Bot runs on today's floor (flagged, purgeable)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/seed-bots"
      },
      {
        "label": "Purge bot ghosts",
        "description": "Remove all bot runs from today's floor",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/purge-bots"
      },
      {
        "label": "Reset my run on the live floor",
        "description": "Dev tool: clear your run, ghost and carving to play again",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-run"
      },
      {
        "label": "Roll over now",
        "description": "Dev tool: open tomorrow's floor from today's crowd",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/roll-now"
      },
      {
        "label": "Set the Warden's links",
        "description": "Dev tool: lower the live Warden's links to test its kill",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/set-links"
      },
      {
        "label": "Post Floor 0",
        "description": "A practice post that plays the tutorial",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-floor0"
      },
      {
        "label": "Post today's floor (to pin)",
        "description": "A post that always opens today's floor and never closes: pin it and link it",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Health",
        "description": "Today's funnel, load times, errors and failed saves",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/health"
      },
      {
        "label": "Write the privacy page",
        "description": "Write Descent's privacy page to the subreddit wiki",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/privacy-page"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "descent_game_test"
  },
  "scheduler": {
    "tasks": {
      "rollover": {
        "endpoint": "/internal/scheduler/rollover",
        "cron": "0 15 * * *"
      },
      "flair": {
        "endpoint": "/internal/scheduler/flair"
      },
      "memorial": {
        "endpoint": "/internal/scheduler/memorial"
      },
      "delvers": {
        "endpoint": "/internal/scheduler/delvers"
      },
      "sweep": {
        "endpoint": "/internal/scheduler/sweep",
        "cron": "30 15 * * *"
      }
    }
  },
  "forms": {
    "seedBots": "/internal/form/seed-bots",
    "setLinks": "/internal/form/set-links",
    "health": "/internal/form/health"
  },
  "settings": {
    "subreddit": {
      "namelessDelvers": {
        "type": "number",
        "label": "Nameless delvers per day",
        "helpText": "Bot ghosts added a few minutes after each new floor, so early floors don't look empty. Shown as nameless delvers; never counted in boards, the funnel or tomorrow's floor. 0 is off; at most 100.",
        "defaultValue": 0
      },
      "devTools": {
        "type": "boolean",
        "label": "Dev tools (reset my run, roll over now, set the Warden's links)",
        "helpText": "Switch off before submission.",
        "defaultValue": false
      }
    }
  }
}
