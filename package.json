{
  "private": true,
  "name": "descent-game",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "bun run test:types && bun run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "bun run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "vitest run --testTimeout=60000",
    "local": "vite --config vite.local.config.ts",
    "check": "tsc --build && vitest run --testTimeout=60000",
    "e2e": "node tests/e2e.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.3",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@devvit/test": "0.15.3",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
